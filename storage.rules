rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Keşfet (Discover) medyaları — yükleme akışı:
    // work_uploads/{uid}_{workId}.{ext}  (bkz. freelancer_upload_work_controller.dart)
    match /work_uploads/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && fileName.matches(request.auth.uid + '_.*')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType in [
             'video/mp4',
             'video/quicktime',
             'image/jpeg',
             'image/png'
           ];

      // Sahibi olmayanlar dosyayı değiştiremez; içerik sadece silinip yeniden yüklenebilir.
      allow update: if false;

      allow delete: if request.auth != null
        && fileName.matches(request.auth.uid + '_.*');
    }

    // Freelancer portfolyo proje görselleri — yükleme akışı:
    // portfolio_thumbnails/{uid}/{timestamp}.jpg (bkz. profile_screens.dart _AddProjectSheet)
    match /portfolio_thumbnails/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];

      allow update: if false;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Profil fotoğrafı — yükleme akışı:
    // profile_images/{uid}.jpg (bkz. profile_screens.dart _editPhoto)
    match /profile_images/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && fileName.matches(request.auth.uid + '\\..*')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];

      // Profil fotoğrafı sabit isimli (uid.jpg) olduğundan değiştirme işlemi
      // Storage tarafında "update" sayılır; create ile aynı koşullarla izin verilir.
      allow update: if request.auth != null
        && fileName.matches(request.auth.uid + '\\..*')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];

      allow delete: if request.auth != null
        && fileName.matches(request.auth.uid + '\\..*');
    }

    // Yukarıdaki yollar dışındaki her şey varsayılan olarak kapalı.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
