rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Keşfet (Discover) medyaları — yükleme akışı:
    // work_uploads/{uid}_{workId}.{ext}  (bkz. freelancer_upload_work_controller.dart)
    match /work_uploads/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && fileName.matches(request.auth.uid + '_.*')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType in [
             'video/mp4',
             'video/quicktime',
             'image/jpeg',
             'image/png'
           ];

      // Sahibi olmayanlar dosyayı değiştiremez; içerik sadece silinip yeniden yüklenebilir.
      allow update: if false;

      allow delete: if request.auth != null
        && fileName.matches(request.auth.uid + '_.*');
    }

    // Yukarıdaki yollar dışındaki her şey varsayılan olarak kapalı.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
